  "out_of_scope": {
    "vv_requirement_rows": {
      "what": "docs/VV_PLAN.md rows V0-R01 .. V3-R09 and the DCOMP / TRACE / TASK rows",
      "why": "each row's status is stated in exactly one document, so it has no copy to diverge from"
    },
    "frozen_criterion_ids": {
      "what": "TL-*, TL-CK-*, LB-*, SEL-*, EP-*, PDR-* criterion ids inside specs and receipts",
      "why": "receipt-bound: their outcome is frozen at execution and must never be rewritten"
    },
    "v_gate_pattern_scanning": {
      "what": "scanning free text for V0..V4",
      "why": "in this repository V1/V2/V3 denote both a V&V gate and a version number (analytical fixture V1, PAPER_RUN_MANIFEST_V2, PUBLICATION-PLAN-V3), so a pattern scan cannot tell them apart. V-gate sites are therefore enumerated, never matched by pattern"
    },
    "prose_references": {
      "what": "sentences that refer to a gate without stating its status (blocked by PUB-B2)",
      "why": "they carry no status, so they cannot go stale"
    }
  },
  "conventions": {
    "status_position": "A table site's status is the accepted form that begins its status cell, after markdown emphasis and backticks are stripped and a short leading particle is allowed. Everything after it is descriptive: 'IN PROGRESS / ... readback PASS' asserts IN_PROGRESS, not PASS.",
    "correction_notes": "Text from a '（**<date> 更正' marker to the end of a cell is a correction note preserving superseded wording under the project's correct-in-place norm. It is history, not the current status, and is excluded before the status is read."
  }
}
